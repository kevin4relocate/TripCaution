{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tripcaution",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-25",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "tripcaution-db", "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_NAME": "TripCaution",
    "SITE_URL": "https://tripcaution.com"
  }
}
