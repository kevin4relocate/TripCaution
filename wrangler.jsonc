{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tripcaution",
  "keep_vars": true,
  "main": "./src/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tripcaution-db",
      "database_id": "5ab8ab1c-2442-4501-a824-9dc1ff924e93",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tripcaution-media"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "SITE_NAME": "TripCaution",
    "AUTO_PUBLISH_ENABLED": "true",
    "THUMBNAIL_AUTOGEN_ENABLED": "true",
    "THUMBNAIL_MODEL": "gemini-3.1-flash-image",
    "SITE_URL": "https://tripcaution.nghiep4tube.workers.dev"
  }
}
