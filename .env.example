# Examples only — set real values in Cloudflare Worker Production settings.
# ADMIN_LOGIN_KEY and INGEST_TOKEN MUST be encrypted Secrets, never committed.
ADMIN_LOGIN_KEY=
INGEST_TOKEN=

# Public plaintext Worker variable. Choose an address you consent to expose.
# Soft launch remains blocked until a real address is set AND receipt is tested.
EDITORIAL_CONTACT_EMAIL=

# Canonical host comes from wrangler.jsonc's SITE_URL, not this file.
# Optional media: configure Cloudflare R2 and add MEDIA binding separately.
